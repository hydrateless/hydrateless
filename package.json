{
  "name": "hydrateless-monorepo",
  "version": "0.10.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm -w packages/enhancers -w packages/hydrateless run build && npm -w packages/auto run build && npm -w packages/react -w packages/vue -w packages/svelte run build",
    "dev": "npm -ws run dev --if-present",
    "lint": "npm -ws run lint --if-present",
    "lint:css": "stylelint \"packages/**/src/**/*.css\"",
    "typecheck": "npm -ws run typecheck --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm -ws run test --if-present",
    "size": "size-limit",
    "docs:dev": "npm -w @hydrateless/docs run docs:dev",
    "docs:build": "npm run build && npm -w @hydrateless/docs run docs:build",
    "clean": "npm -ws run clean --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^11.0.1",
    "@size-limit/file": "^14.0.0",
    "autoprefixer": "^10.6.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "cssnano": "^9.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.5.3",
    "eslint-plugin-tsdoc": "^0.5.3",
    "husky": "^9.1.6",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.4.49",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.5.3",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-svelte": "^4.1.1",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{css,md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@10"
}
