{
  "name": "hydrateless-monorepo",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm -w packages/enhancers -w packages/hydrateless run build && npm -w packages/auto run build && npm -w packages/react -w packages/vue -w packages/svelte run build",
    "dev": "npm -ws run dev --if-present",
    "lint": "npm -ws run lint --if-present",
    "typecheck": "npm -ws run typecheck --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm -ws run test --if-present",
    "docs:dev": "npm -w @hydrateless/docs run docs:dev",
    "docs:build": "npm -w @hydrateless/docs run docs:build",
    "clean": "npm -ws run clean --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "autoprefixer": "^10.4.20",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cssnano": "^6.1.2",
    "eslint": "^9.13.0",
    "husky": "^9.1.6",
    "jsdom": "^29.0.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.0.5",
    "prettier": "^3.3.3",
    "semantic-release": "^24.2.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{css,md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@10"
}
