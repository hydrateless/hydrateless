{
  "name": "hydrateless",
  "version": "0.5.0",
  "description": "Accessible, themeable UI primitives — semantic HTML + modern CSS first, optional JS enhancers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hydrateless/hydrateless.git",
    "directory": "packages/hydrateless"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "style": "dist/hydrateless.css",
  "unpkg": "dist/hydrateless.min.css",
  "jsdelivr": "dist/hydrateless.min.css",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build -- --watch"
  },
  "exports": {
    ".": {
      "style": "./dist/hydrateless.css",
      "default": "./dist/hydrateless.css"
    },
    "./hydrateless.css": "./dist/hydrateless.css",
    "./hydrateless.min.css": "./dist/hydrateless.min.css",
    "./reset.css": "./dist/reset.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./components.css": "./dist/components.css",
    "./accordion.css": "./dist/accordion.css",
    "./disclosure.css": "./dist/disclosure.css",
    "./drawer.css": "./dist/drawer.css",
    "./modal.css": "./dist/modal.css",
    "./popover.css": "./dist/popover.css",
    "./skip-link.css": "./dist/skip-link.css",
    "./switch.css": "./dist/switch.css",
    "./tabs.css": "./dist/tabs.css",
    "./toc.css": "./dist/toc.css",
    "./tooltip.css": "./dist/tooltip.css",
    "./breadcrumb.css": "./dist/breadcrumb.css",
    "./dropdown.css": "./dist/dropdown.css",
    "./toast.css": "./dist/toast.css",
    "./menu.css": "./dist/menu.css",
    "./combobox.css": "./dist/combobox.css",
    "./command.css": "./dist/command.css",
    "./button.css": "./dist/button.css",
    "./input.css": "./dist/input.css",
    "./textarea.css": "./dist/textarea.css",
    "./select.css": "./dist/select.css",
    "./checkbox.css": "./dist/checkbox.css",
    "./radio.css": "./dist/radio.css",
    "./field.css": "./dist/field.css",
    "./segmented.css": "./dist/segmented.css",
    "./slider.css": "./dist/slider.css",
    "./alert.css": "./dist/alert.css",
    "./badge.css": "./dist/badge.css",
    "./card.css": "./dist/card.css",
    "./avatar.css": "./dist/avatar.css",
    "./progress.css": "./dist/progress.css",
    "./spinner.css": "./dist/spinner.css",
    "./skeleton.css": "./dist/skeleton.css",
    "./kbd.css": "./dist/kbd.css",
    "./table.css": "./dist/table.css",
    "./pagination.css": "./dist/pagination.css",
    "./separator.css": "./dist/separator.css"
  },
  "publishConfig": {
    "access": "public"
  }
}
