{
  "name": "@hydrateless/svelte",
  "version": "0.6.0",
  "description": "Svelte 5 bindings for Hydrateless — first-class components, actions, and a toast store.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hydrateless/hydrateless.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.svelte"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@hydrateless/enhancers": "^0.6.0"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "axe-core": "^4.12.0",
    "jsdom": "^29.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
