{
  "name": "@hydrateless/auto",
  "version": "0.5.0",
  "description": "Drop-in auto-initializer for Hydrateless — detects data-hl-* attributes and lazy-loads enhancers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hydrateless/hydrateless.git",
    "directory": "packages/auto"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "unpkg": "dist/hydrateless.js",
  "jsdelivr": "dist/hydrateless.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hydrateless.js": "./dist/hydrateless.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@hydrateless/enhancers": "^0.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
