{
  "name": "@hydrateless/auto",
  "version": "0.0.0",
  "description": "Drop-in auto-initializer for Hydrateless — detects data-hl-* attributes and lazy-loads enhancers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hydrateless/hydrateless.git",
    "directory": "packages/auto"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm --clean",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@hydrateless/enhancers": "^0.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
