{
  "name": "@hydrateless/enhancers",
  "version": "0.2.0",
  "description": "Optional JS enhancers for Hydrateless components — focus traps, keyboard nav, ARIA wiring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hydrateless/hydrateless.git",
    "directory": "packages/enhancers"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./disclosure": {
      "types": "./dist/disclosure/index.d.ts",
      "import": "./dist/disclosure/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "import": "./dist/accordion/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js"
    },
    "./toc": {
      "types": "./dist/toc/index.d.ts",
      "import": "./dist/toc/index.js"
    },
    "./drawer": {
      "types": "./dist/drawer/index.d.ts",
      "import": "./dist/drawer/index.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "import": "./dist/popover/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown/index.d.ts",
      "import": "./dist/dropdown/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/disclosure/index.ts src/tabs/index.ts src/accordion/index.ts src/modal/index.ts src/toc/index.ts src/drawer/index.ts src/popover/index.ts src/tooltip/index.ts src/dropdown/index.ts src/toast/index.ts --dts --format esm --clean",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "jsdom": "^29.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
