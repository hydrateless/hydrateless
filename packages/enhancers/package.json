{
  "name": "@hydrateless/enhancers",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./disclosure": "./dist/disclosure/index.js",
    "./tabs": "./dist/tabs/index.js",
    "./accordion": "./dist/accordion/index.js",
    "./modal": "./dist/modal/index.js",
    "./toc": "./dist/toc/index.js",
    "./drawer": "./dist/drawer/index.js",
    "./popover": "./dist/popover/index.js",
    "./tooltip": "./dist/tooltip/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/disclosure/index.ts src/tabs/index.ts src/accordion/index.ts src/modal/index.ts src/toc/index.ts src/drawer/index.ts src/popover/index.ts src/tooltip/index.ts --dts --format esm --clean",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hydrateless/utils": "^0.0.0"
  },
  "publishConfig": { "access": "public" }
}
