{
  "name": "@hydrateless/e2e",
  "version": "0.10.1",
  "private": true,
  "description": "Real-browser end-to-end and accessibility tests for Hydrateless across Chromium, Firefox, and WebKit.",
  "type": "module",
  "scripts": {
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.4.1"
  }
}
