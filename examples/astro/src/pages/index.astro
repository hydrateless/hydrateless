---
import Base from '../layouts/Base.astro';
---

<Base title="Hydrateless: Astro Example">
  <nav data-hl-breadcrumb aria-label="Breadcrumb">
    <ol>
      <li><a href="#">Home</a></li>
      <li><a href="#">Examples</a></li>
      <li><span aria-current="page">Astro</span></li>
    </ol>
  </nav>

  <h1>
    Hydrateless for Astro
    <span class="hl-badge" data-hl-intent="primary" data-hl-variant="soft">v0.5</span>
  </h1>
  <p>
    Astro ships static HTML; Hydrateless components <em>are</em> static HTML. The auto-initializer lazy-loads
    a tiny enhancer only where an interaction needs it.
  </p>

  <section>
    <h2>Tabs</h2>
    <div data-hl-tabs>
      <div role="tablist">
        <button role="tab">Overview</button>
        <button role="tab">Install</button>
      </div>
      <div role="tabpanel"><p>Zero runtime by default.</p></div>
      <div role="tabpanel"><p><code>npm install hydrateless @hydrateless/auto</code></p></div>
    </div>
  </section>

  <section>
    <h2>Accordion</h2>
    <div data-hl-accordion>
      <details>
        <summary>What is Hydrateless?</summary>
        <div class="hl-accordion-panel">
          A CSS-first component library with optional JS enhancers.
        </div>
      </details>
      <details>
        <summary>Do I need JavaScript?</summary>
        <div class="hl-accordion-panel">Most components work without it.</div>
      </details>
    </div>
  </section>

  <section>
    <h2>Dropdown</h2>
    <div data-hl-dropdown>
      <button data-hl-dropdown-trigger>Actions</button>
      <ul data-hl-dropdown-menu>
        <li><button role="menuitem">Edit</button></li>
        <li><button role="menuitem">Duplicate</button></li>
        <li role="separator"></li>
        <li><button role="menuitem">Delete</button></li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Modal</h2>
    <button data-hl-modal-open="demo-modal">Open modal</button>
    <dialog id="demo-modal" class="hl-modal" data-hl-modal>
      <div class="hl-modal-header"><strong>Confirm</strong></div>
      <div class="hl-modal-body"><p>Focus is trapped. Press Escape to close.</p></div>
      <div class="hl-modal-footer"><button data-hl-modal-close>Close</button></div>
    </dialog>
  </section>
</Base>
