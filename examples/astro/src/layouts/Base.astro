---
import 'hydrateless/hydrateless.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <style is:global>
      body {
        margin: 0;
        font-family: var(--hl-font-sans);
        color: var(--hl-fg);
        background: var(--hl-bg);
      }
      .page {
        max-inline-size: 42rem;
        margin: 0 auto;
        padding: var(--hl-space-8) var(--hl-space-4);
        display: grid;
        gap: var(--hl-space-8);
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--hl-space-4);
      }
      h1,
      h2 {
        margin: 0 0 var(--hl-space-3);
      }
      .row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--hl-space-3);
      }
      .stack {
        display: grid;
        gap: var(--hl-space-4);
      }
    </style>
    <a class="hl-skip-link" href="#main">Skip to content</a>
    <main id="main" class="page">
      <slot />
    </main>

    <!-- Bundled by Astro and shipped to the browser. Scans the page and
         lazy-loads only the enhancers the page actually uses. -->
    <script>
      import '@hydrateless/auto';
    </script>
  </body>
</html>
